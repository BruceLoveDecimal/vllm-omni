[
    {
        "test_name": "test_sana_wm_official_bridge_eager",
        "description": "SANA-WM official bridge baseline with local SANA-WM weights and NVlabs/Sana runner",
        "server_type": "vllm-omni",
        "server_params": {
            "model": "Efficient-Large-Model/SANA-WM_bidirectional",
            "model_class_name": "SanaWmTwoStagesPipeline",
            "serve_args": {
                "enforce-eager": true,
                "enable-diffusion-pipeline-profiler": true
            },
            "env": {
                "VLLM_OMNI_SANA_WM_USE_OFFICIAL_CLI": "1",
                "TORCHDYNAMO_DISABLE": "1"
            }
        },
        "benchmark_params": [
            {
                "name": "704x1280_9f_steps1_action",
                "dataset": "random",
                "task": "i2v",
                "backend": "v1/videos",
                "width": 1280,
                "height": 704,
                "num-frames": 9,
                "fps": 16,
                "num-inference-steps": 1,
                "num-prompts": 1,
                "max-concurrency": 1,
                "extra-params": {
                    "sana_wm": {
                        "action": "w-16",
                        "translation_speed": 0.055,
                        "rotation_speed_deg": 1.2,
                        "intrinsics": {
                            "fx": 640,
                            "fy": 640,
                            "cx": 640,
                            "cy": 352
                        }
                    }
                }
            }
        ]
    },
